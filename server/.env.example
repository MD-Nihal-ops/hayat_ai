PORT=3000
# Set JWT_SECRET to a long random string. Never commit it.
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
# Demo-only signing secret. Use a different secret per organisation in real deployments.
HAYAT_LINK_DEMO_ORG_NAME=Hayat Link Demo Organisation
HAYAT_LINK_DEMO_ORG_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
# Additional organisations may use HAYAT_LINK_ORG_<NORMALIZED_ORG_NAME>_SECRET.
# This key must never be sent to the frontend.
AI_API_KEY=your_key_here
AI_MODEL_PRIMARY=gemini-3.8-flash
AI_MODEL_FALLBACK=put_a_lite_model_name_here
# Chat defaults to the existing Gemini path. xKiro chat is opt-in and must
# not receive health data until its privacy and downstream-provider terms are reviewed.
AI_CHAT_PROVIDER=gemini
XKIRO_API_KEY=your_xkiro_key_here
XKIRO_MODEL_PRIMARY=mistralai/mistral-medium-3.5
XKIRO_ALLOW_HEALTH_DATA=false
